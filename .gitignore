#include <stdio.h>
#include <stdlib.h>
struct node {
 int data;
 struct node *left, *right;
};
struct node* createNode(int value) {
 struct node *newnode =
 (struct node*)malloc(sizeof(struct node));
 newnode->data = value;
 newnode->left = newnode->right = NULL;
 return newnode;
}
struct node* insert(struct node *root, int value) {
 if (root == NULL)
 return createNode(value);
 if (value < root->data)
 root->left = insert(root->left, value);
 else
 root->right = insert(root->right, value);
 return root;
}
void inorder(struct node *root) {
 if (root != NULL) {
 inorder(root->left);
 printf("%d ", root->data);
 inorder(root->right);
 }
}
void preorder(struct node *root) {
 if (root != NULL) {
 printf("%d ", root->data);
 preorder(root->left);
 preorder(root->right);
 }
}
void postorder(struct node *root) {
 if (root != NULL) {
 postorder(root->left);
 postorder(root->right);
 printf("%d ", root->data);
 }
}
int bstSearch(struct node *root, int key, int *count) {
 while (root != NULL) {
 (*count)++;
 if (key == root->data)
 return 1;
 else if (key < root->data)
 root = root->left;
 else
 root = root->right;
 }
 return 0;
} BST Assignment - Code and Output Page 2
int linearSearch(int a[], int n, int key, int *count) {
 for (int i = 0; i < n; i++) {
 (*count)++;
 if (a[i] == key)
 return 1;
 }
 return 0;
}
int main() {
 int a[] = {45, 20, 60, 10, 30, 50, 70, 25, 55};
 int n = 9;
 int keys[] = {25, 55, 90};
 int k = 3;
 struct node *root = NULL;
 for (int i = 0; i < n; i++)
 root = insert(root, a[i]);
 printf("Inorder: ");
 inorder(root);
 printf("\nPreorder: ");
 preorder(root);
 printf("\nPostorder: ");
 postorder(root);
 for (int i = 0; i < k; i++) {
 int bstCount = 0, linearCount = 0;
 int foundBST = bstSearch(root, keys[i], &bstCount);
 int foundLinear = linearSearch(a, n, keys[i], &linearCount);
 printf("\n\nKey = %d", keys[i]);
 printf("\nBST: %s, Comparisons = %d",
 foundBST ? "Found" : "Not Found", bstCount);
 printf("\nLinear: %s, Comparisons = %d",
 foundLinear ? "Found" : "Not Found", linearCount);
 }
 return 0;
}